<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Per-user agent:
    cp contrib/org.sysmon.sysmond.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/org.sysmon.sysmond.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.sysmon.sysmond</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/sysmond</string>
        <string>-f</string>
        <string>-c</string>
        <string>/usr/local/etc/sysmond.conf</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/sysmond.err</string>
</dict>
</plist>
