# sysmond configuration
#
# ini-style: [section], key = value, '#' or ';' start a comment.
# Keys that may appear several times (mount, load, rule) build a list.

[core]
# seconds between two samples
interval = 5
# error | warn | info | debug
log_level = info
#log_file = /var/log/sysmond.log
#pid_file = /run/sysmond.pid
socket = /tmp/sysmond.sock

[disk]
# defaults to "/" when no mount is listed
mount = /
#mount = /home

[plugins]
dir = /usr/local/lib/sysmon/plugins
load = uptime
load = net

[http]
# Prometheus endpoint at http://BIND:PORT/metrics, 0 disables it.
# There is no authentication: keep it on localhost or behind a proxy.
port = 9273
bind = 127.0.0.1
